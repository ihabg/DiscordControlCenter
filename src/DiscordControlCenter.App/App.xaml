<Application x:Class="DiscordControlCenter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DiscordControlCenter.App.Converters"
             xmlns:vm="clr-namespace:DiscordControlCenter.App.ViewModels"
             xmlns:views="clr-namespace:DiscordControlCenter.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiscordControlCenter.App;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:StateToBrushConverter x:Key="StateToBrushConverter" />
            <converters:CachedImageConverter x:Key="CachedImageConverter" />
            <converters:PermissionStatusToBrushConverter x:Key="PermissionStatusToBrushConverter" />
            <converters:PermissionStatusToTextConverter x:Key="PermissionStatusToTextConverter" />
            <converters:RoleColorConverter x:Key="RoleColorConverter" />
            <converters:FriendlyDisplayConverter x:Key="FriendlyDisplayConverter" />

            <DataTemplate DataType="{x:Type vm:ChannelOptionViewModel}">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoleOptionViewModel}">
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BotsViewModel}">
                <views:BotsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServersViewModel}">
                <views:ServersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChannelsViewModel}">
                <views:ChannelsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MembersViewModel}">
                <views:MembersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RolesViewModel}">
                <views:RolesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PermissionSimulatorViewModel}">
                <views:PermissionSimulatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VoiceViewModel}">
                <views:VoiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OperationCenterViewModel}">
                <views:OperationCenterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupBrowserViewModel}">
                <views:BackupBrowserView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MessagesViewModel}">
                <views:MessagesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AutomationViewModel}">
                <views:AutomationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
