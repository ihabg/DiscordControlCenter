<UserControl x:Class="DiscordControlCenter.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="24,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" MinWidth="390" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelSurfaceStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Accessible servers" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Live gateway cache for the selected bot"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7"
                            VerticalAlignment="Top"
                            ToolTip="Refresh servers and channels from the selected bot runtime"
                            automation:AutomationProperties.Name="Refresh server explorer" />
                    <TextBox Grid.ColumnSpan="2"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search server name or ID"
                             Margin="0,54,0,0"
                             ToolTip="Search servers by name or numeric Discord ID"
                             automation:AutomationProperties.Name="Search servers" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer}"
                         ItemContainerStyle="{StaticResource DataRowContainerStyle}"
                         Background="{StaticResource SurfaceBrush}"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         automation:AutomationProperties.Name="Server list">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34"
                                        Background="{StaticResource ElevatedSurfaceBrush}"
                                        CornerRadius="17">
                                    <Image Source="{Binding IconUrl, Converter={StaticResource CachedImageConverter}}"
                                           Width="34" Height="34" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding SummaryText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding BotSummaryText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding AvailabilityText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Right">
                                        <Run Text="{Binding RoleCountText, Mode=OneWay}" />
                                        <Run Text=" roles" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        Visibility="{Binding HasServers, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="300"
                                Margin="24">
                        <ProgressBar IsIndeterminate="True"
                                     Width="150"
                                     Height="4"
                                     Margin="0,0,0,18"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StateTitle}"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StateMessage}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Button Content="Retry"
                                Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                automation:AutomationProperties.Name="Retry loading servers" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelSurfaceStyle}" Padding="0">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="360">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Select a server"
                               Style="{StaticResource SectionHeadingStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Choose a server from the list to inspect metadata, statistics, and effective bot permissions."
                               Style="{StaticResource SecondaryTextStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48"
                                    Background="{StaticResource ElevatedSurfaceBrush}"
                                    CornerRadius="24">
                                <Image Source="{Binding SelectedServer.IconUrl, Converter={StaticResource CachedImageConverter}}"
                                       Width="48" Height="48" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedServer.Name}"
                                           Style="{StaticResource PageHeadingStyle}"
                                           FontSize="23"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedServer.Name}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                    <Run Text="ID " />
                                    <Run Text="{Binding SelectedServer.IdText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding SelectedServer.AvailabilityText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SelectedServer.Description}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <TextBlock Text="Server information"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,22,0,12" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="OWNER ID" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.OwnerIdText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="CREATED" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.CreatedAtText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="MEMBERS" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.MemberCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="BOOST TIER" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.BoostTierText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="BOOST COUNT" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.BoostCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="EMOJIS" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.EmojiCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Channel and role statistics"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,8,0,12" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="CATEGORIES" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.CategoryCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="TEXT" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.TextChannelCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="VOICE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.VoiceChannelCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="STAGE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.StageChannelCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="FORUM / MEDIA" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.ForumChannelCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="ROLES" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.RoleCountText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Selected bot"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,8,0,12" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="NICKNAME" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.BotNicknameText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="HIGHEST ROLE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.BotHighestRoleText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="ROLE POSITION" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedServer.BotRolePositionText}" Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Effective server permissions"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,8,0,10" />
                        <ItemsControl ItemsSource="{Binding SelectedServer.Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status, Converter={StaticResource PermissionStatusToTextConverter}}"
                                                   Foreground="{Binding Status, Converter={StaticResource PermissionStatusToBrushConverter}}"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Source}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0">
                            <Run Text="Last refreshed " />
                            <Run Text="{Binding SelectedServer.RefreshedAtText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
