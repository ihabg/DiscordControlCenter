<Window x:Class="DiscordControlCenter.App.Views.AddBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Add Discord bot"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="14" Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Add Discord bot"
                           Style="{StaticResource PageHeadingStyle}"
                           FontSize="23" />
                <TextBlock Text="Use a bot token from the Discord Developer Portal. User tokens and self-bots are not supported."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Style="{StaticResource FormLabelStyle}">
                    <Run Text="Display name" />
                    <Run Text="  *" Foreground="{StaticResource DangerTextBrush}" />
                </TextBlock>
                <TextBox x:Name="DisplayNameBox"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Friendly name for this bot"
                         MaxLength="80"
                         IsEnabled="{Binding CanCancel}"
                         TabIndex="0"
                         LostFocus="OnDisplayNameLostFocus"
                         automation:AutomationProperties.Name="Display name, required"
                         automation:AutomationProperties.HelpText="Friendly name for this bot" />
                <TextBlock Text="{Binding DisplayNameError}"
                           Style="{StaticResource ValidationMessageStyle}"
                           Visibility="{Binding HasDisplayNameError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           automation:AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource FormLabelStyle}">
                    <Run Text="Bot token" />
                    <Run Text="  *" Foreground="{StaticResource DangerTextBrush}" />
                </TextBlock>
                <Grid>
                    <PasswordBox x:Name="TokenBox"
                                 IsEnabled="{Binding CanCancel}"
                                 TabIndex="1"
                                 PasswordChanged="OnPasswordChanged"
                                 LostFocus="OnTokenLostFocus"
                                 automation:AutomationProperties.Name="Bot token, required"
                                 automation:AutomationProperties.HelpText="Paste the token from the Discord Developer Portal" />
                    <TextBlock x:Name="TokenPlaceholder"
                               Text="Paste the token from the Discord Developer Portal"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="13,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
                <TextBlock Text="{Binding TokenError}"
                           Style="{StaticResource ValidationMessageStyle}"
                           Visibility="{Binding HasTokenError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="The token is validated with Discord, encrypted with Windows DPAPI for this Windows user, and never shown again."
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
            </StackPanel>

            <Border Grid.Row="3"
                    Background="{StaticResource DangerSurfaceBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ValidationMessageStyle}"
                           Margin="0"
                           automation:AutomationProperties.LiveSetting="Assertive" />
            </Border>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="100" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="Validating credentials…"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Click="OnCancelClick"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            IsEnabled="{Binding CanCancel}"
                            TabIndex="2"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            TabIndex="3"
                            ToolTip="Validate the token with Discord and save it using Windows protection"
                            ToolTipService.ShowOnDisabled="True"
                            automation:AutomationProperties.HelpText="Complete both required fields before saving" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
