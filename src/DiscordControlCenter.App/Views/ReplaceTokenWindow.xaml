<Window x:Class="DiscordControlCenter.App.Views.ReplaceTokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Replace bot token"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="14" Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Replace protected token"
                           Style="{StaticResource PageHeadingStyle}"
                           FontSize="23" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0">
                    <Run Text="Enter a new token for " />
                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=". It must authenticate as the same Discord bot." />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Style="{StaticResource FormLabelStyle}">
                    <Run Text="New bot token" />
                    <Run Text="  *" Foreground="{StaticResource DangerTextBrush}" />
                </TextBlock>
                <Grid>
                    <PasswordBox x:Name="TokenBox"
                                 IsEnabled="{Binding CanCancel}"
                                 TabIndex="0"
                                 PasswordChanged="OnPasswordChanged"
                                 LostFocus="OnTokenLostFocus"
                                 automation:AutomationProperties.Name="New bot token, required"
                                 automation:AutomationProperties.HelpText="Paste the replacement token from the Discord Developer Portal" />
                    <TextBlock x:Name="TokenPlaceholder"
                               Text="Paste the replacement token from the Discord Developer Portal"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="13,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
                <TextBlock Text="{Binding TokenError}"
                           Style="{StaticResource ValidationMessageStyle}"
                           Visibility="{Binding HasTokenError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="The saved token remains hidden. Only the newly entered value is sent to Discord for validation, then protected with Windows DPAPI."
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource DangerSurfaceBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ValidationMessageStyle}"
                           Margin="0"
                           automation:AutomationProperties.LiveSetting="Assertive" />
            </Border>

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="100" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="Validating credentials…"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Click="OnCancelClick"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            IsEnabled="{Binding CanCancel}"
                            TabIndex="1"
                            Margin="0,0,8,0" />
                    <Button Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            TabIndex="2"
                            ToolTip="Validate and replace the protected bot token"
                            ToolTipService.ShowOnDisabled="True"
                            automation:AutomationProperties.HelpText="Enter a replacement token before validating" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
