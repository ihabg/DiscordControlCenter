<UserControl x:Class="DiscordControlCenter.App.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="24,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="430" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Discord role hierarchy"
                               Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Highest roles appear first; @everyone remains clearly identified at the bottom."
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CompletenessText}"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Roles}"
                             SelectedItem="{Binding SelectedRole}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             automation:AutomationProperties.Name="Server roles">
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="DataRowContainerStyle" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12"
                                             Height="12"
                                             Fill="{Binding ColorRaw, Converter={StaticResource RoleColorConverter}}"
                                             Stroke="{StaticResource BorderBrush}"
                                             StrokeThickness="1" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11">
                                            <Run Text="Position " />
                                            <Run Text="{Binding PositionText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ManagedText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding BotHierarchyText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding BotHierarchyText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MemberCountText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right">
                                            <Run Text="{Binding PermissionCountText, Mode=OneWay}" />
                                            <Run Text=" permissions" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="290"
                                IsHitTestVisible="False">
                        <TextBlock Text="{Binding StateTitle}"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding StateMessage}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelSurfaceStyle}">
            <ContentControl Content="{Binding SelectedRole}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel MinWidth="410">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Ellipse Width="28"
                                             Height="28"
                                             Fill="{Binding ColorRaw, Converter={StaticResource RoleColorConverter}}"
                                             Stroke="{StaticResource BorderBrush}"
                                             StrokeThickness="1"
                                             Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource PageHeadingStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding IdText}"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="POSITION" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding PositionText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="CREATED" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,0,12"><TextBlock Text="COLOR" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding ColorText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="HOISTED" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding HoistedText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="MENTIONABLE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding MentionableText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,0,12"><TextBlock Text="MANAGED" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding ManagedText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="ICON" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding IconText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,12,12"><TextBlock Text="MEMBERS" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding MemberCountText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    <StackPanel Margin="0,0,0,12"><TextBlock Text="TAGS" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding TagsText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                </UniformGrid>
                                <Border Background="{StaticResource ElevatedSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="12"
                                        Margin="0,8,0,14">
                                    <StackPanel>
                                        <TextBlock Text="READ-ONLY HIERARCHY PREFLIGHT"
                                                   Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Text="{Binding ManageabilityText}"
                                                   Style="{StaticResource DetailValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding AssignabilityText}"
                                                   Style="{StaticResource DetailValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding BotHierarchyText}"
                                                   Style="{StaticResource DetailValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ReorderabilityText}"
                                                   Style="{StaticResource DetailValueStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="BASE PERMISSIONS"
                                           Style="{StaticResource DetailLabelStyle}" />
                                <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,7">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
