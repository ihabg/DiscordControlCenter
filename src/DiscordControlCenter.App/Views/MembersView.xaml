<UserControl x:Class="DiscordControlCenter.App.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="14"
                CornerRadius="8"
                BorderThickness="1"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLimitedMode}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ModeTitle}"
                               Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="{Binding ModeMessage}"
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,14,0" />
                    <TextBlock Text="{Binding ProgressText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,7,0,0" />
                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11">
                        <Run Text="Last refreshed: " />
                        <Run Text="{Binding LastRefreshedText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh members"
                        Command="{Binding LoadMembersCommand}"
                        VerticalAlignment="Center"
                        ToolTip="Cancel-safe, rate-limit-aware member loading"
                        ToolTipService.ShowOnDisabled="True"
                        automation:AutomationProperties.Name="Refresh members"
                        automation:AutomationProperties.HelpText="Requires local GuildMembers selection and the matching Developer Portal toggle" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search username, display name, nickname, or ID"
                             automation:AutomationProperties.Name="Search members" />
                    <Grid Grid.Row="1" Margin="0,10,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Filters}"
                                  SelectedItem="{Binding SelectedFilter}"
                                  automation:AutomationProperties.Name="Member filter" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding RoleFilters}"
                                  SelectedItem="{Binding SelectedRoleFilter}"
                                  automation:AutomationProperties.Name="Role filter" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding MembersView}"
                                 SelectedItem="{Binding SelectedMember}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 automation:AutomationProperties.Name="Members">
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="DataRowContainerStyle" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32"
                                                Height="32"
                                                CornerRadius="16"
                                                Background="{StaticResource ElevatedSurfaceBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding AvatarUrl, Converter={StaticResource CachedImageConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Username, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding IdText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AccountType}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding VoiceChannel}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10"
                                                       MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="300"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{Binding StateTitle}"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding StateMessage}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelSurfaceStyle}">
                <ContentControl Content="{Binding SelectedMember}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Border Width="58"
                                                Height="58"
                                                CornerRadius="29"
                                                Background="{StaticResource ElevatedSurfaceBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding AvatarUrl, Converter={StaticResource CachedImageConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="14,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource PageHeadingStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Username}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{Binding IdText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="GLOBAL DISPLAY" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding GlobalDisplayName}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="SERVER NICKNAME" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding Nickname}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="ACCOUNT TYPE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding AccountType}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="ACCOUNT CREATED" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="JOINED SERVER" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding JoinedAtText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="HIGHEST ROLE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding HighestRole}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="ASSIGNED ROLES" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding RoleCountText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="BOOSTING" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding BoostingText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="BOOST START" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding BoostStartedText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="SCREENING PENDING" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding PendingText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,14,12"><TextBlock Text="TIMEOUT EXPIRATION" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding TimeoutText}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock Text="VOICE CHANNEL" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding VoiceChannel}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="VOICE STATE" Style="{StaticResource DetailLabelStyle}" Margin="0,8,0,3" />
                                    <TextBlock Text="{Binding VoiceFlags}"
                                               Style="{StaticResource DetailValueStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
