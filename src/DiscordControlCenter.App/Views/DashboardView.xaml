<UserControl x:Class="DiscordControlCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,28">
            <TextBlock Text="System overview" Style="{StaticResource PageHeadingStyle}" />
            <TextBlock Text="Live health across bot connections and available servers."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,24" />

            <Border Background="{StaticResource SelectionBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="16" Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TotalBots}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="No bots have been added yet" Style="{StaticResource SectionHeadingStyle}" FontSize="14" />
                    <TextBlock Text="Open Bot Manager from the left navigation, choose Add bot, and enter an official bot token. The token will be validated and encrypted for this Windows account."
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,22">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="CONNECTED BOTS" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Text="{Binding ConnectedBots}" Style="{StaticResource PageHeadingStyle}" FontSize="31" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="DISCONNECTED" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Text="{Binding DisconnectedBots}" Style="{StaticResource PageHeadingStyle}" FontSize="31" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="AVAILABLE SERVERS" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Text="{Binding AvailableServers}" Style="{StaticResource PageHeadingStyle}" FontSize="31" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="AVERAGE LATENCY" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Text="{Binding AverageLatency}" Style="{StaticResource PageHeadingStyle}" FontSize="31" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Recent actions" Style="{StaticResource SectionHeadingStyle}" />
                        <ItemsControl ItemsSource="{Binding RecentActions}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,11">
                                        <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Actions will appear here after you add or manage a bot."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentActions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Connection problems" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{Binding ConnectionProblems}" Style="{StaticResource PageHeadingStyle}" FontSize="27" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Active voice connections" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{Binding ActiveVoiceConnections}" Style="{StaticResource PageHeadingStyle}" FontSize="27" Margin="0,7,0,0" />
                            <TextBlock Text="The Phase 3 inspector observes voice state without connecting bots to voice."
                                       TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Gateway and cache health"
                               Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Compact safe diagnostics per bot. Raw payloads, authorization data, and message contents are never shown."
                               Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ElevatedSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="14"
                                        Margin="0,0,0,9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding Connection, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Latency, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="CACHE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding CacheCounts}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="MEMBERS" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding Members}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="GUILDMEMBERS" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding GuildMembers}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,0,10"><TextBlock Text="CACHE AGE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding CacheAge}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="LAST READY" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding LastReady}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="LAST DISCONNECT" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding LastDisconnect}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,10"><TextBlock Text="LAST RECONNECT" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding LastReconnect}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,0,10"><TextBlock Text="REFRESH" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding Refresh}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="SEQUENCE" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding Sequence}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Text="VOICE ACTIVITY" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding VoiceActivity}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                            <StackPanel Margin="0,0,0,0"><TextBlock Text="RECENT GATEWAY ERROR" Style="{StaticResource DetailLabelStyle}" /><TextBlock Text="{Binding GatewayError}" Style="{StaticResource DetailValueStyle}" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
