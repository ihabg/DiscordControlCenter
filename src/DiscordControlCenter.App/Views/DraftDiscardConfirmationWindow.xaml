<Window x:Class="DiscordControlCenter.App.Views.DraftDiscardConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Keep unsaved draft changes?" Width="500" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="KEEP UNSAVED CHANGES?" Style="{StaticResource PageHeadingStyle}"/>
            <TextBlock x:Name="ActionText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock Text="Discarding will permanently remove the current unsaved draft edits. Keep editing is the safe default." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Keep editing" IsCancel="True" IsDefault="True" Style="{StaticResource SecondaryButtonStyle}" automation:AutomationProperties.AutomationId="DiscordControlCenter.ScheduledMessages.Draft.Discard.Keep"/>
            <Button Content="Discard changes" Click="Discard_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" automation:AutomationProperties.AutomationId="DiscordControlCenter.ScheduledMessages.Draft.Discard.Confirm"/>
        </StackPanel>
    </Grid>
</Window>
