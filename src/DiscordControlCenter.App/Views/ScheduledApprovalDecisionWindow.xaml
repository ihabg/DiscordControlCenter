<Window x:Class="DiscordControlCenter.App.Views.ScheduledApprovalDecisionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirm scheduled message decision" Width="620" Height="500" WindowStartupLocation="CenterOwner" Background="{StaticResource ContentBackgroundBrush}">
 <DockPanel Margin="22"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Confirm" IsDefault="True" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Action}" Style="{StaticResource PageHeadingStyle}"/><TextBlock Text="{Binding Approval.Snapshot.Destination.ChannelName}" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/><TextBlock Text="{Binding Approval.ImmutableContent.Body}" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding Approval.ImmutableContent.Embed.Title}" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding Approval.ImmutableContent.Embed.Description}" TextWrapping="Wrap"/><TextBlock Text="This preview is immutable; later schedule or template edits do not affect it." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/><StackPanel Visibility="{Binding RequiresTypedConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,14,0,0"><TextBlock Text="This message allows broad mentions. Type SEND MISSED MESSAGE to continue." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/><TextBox Text="{Binding TypedConfirmation, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/></StackPanel></StackPanel></ScrollViewer></DockPanel>
</Window>
