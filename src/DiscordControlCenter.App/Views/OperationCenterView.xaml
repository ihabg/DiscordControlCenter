<UserControl x:Class="DiscordControlCenter.App.Views.OperationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{StaticResource ContentBackgroundBrush}">
    <Grid Margin="24,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="330" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" MinWidth="430" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelSurfaceStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="18,17,18,12">
                    <TextBlock Text="Operation history" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Persisted plans, progress, and reconciled outcomes"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Operations}"
                         SelectedItem="{Binding SelectedOperation}"
                         Background="{StaticResource SurfaceBrush}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         automation:AutomationProperties.Name="Channel operation history">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="FocusVisualStyle"
                                    Value="{StaticResource KeyboardFocusVisualStyle}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ServerName, Mode=OneWay}" />
                                        <Run Text="  •  " />
                                        <Run Text="{Binding CreatedAtText, Mode=OneWay}" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                 Maximum="100"
                                                 Height="3"
                                                 Margin="0,7,8,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding StateText}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding ProgressText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1"
                        Background="{StaticResource OverlayBackgroundBrush}"
                        Visibility="{Binding HasOperations,
                                             Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="290"
                                Margin="24">
                        <TextBlock Text="{Binding EmptyTitle}"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding EmptyMessage}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PanelSurfaceStyle}" Padding="0">
            <Grid>
                <TextBlock Text="Select an operation to inspect its safe technical result."
                           Style="{StaticResource SecondaryTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="330"
                           Visibility="{Binding HasSelection,
                                                Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="22">
                        <TextBlock Text="{Binding SelectedOperation.Title}"
                                   Style="{StaticResource PageHeadingStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0">
                            <Run Text="{Binding SelectedOperation.OperationTypeText, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding SelectedOperation.RiskText, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding SelectedOperation.StateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedOperation.StatusSummary}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,9,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Cancel remaining work"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0,0,10,0"
                                    automation:AutomationProperties.Name="Cancel selected operation" />
                            <Button Content="Regenerate preview"
                                    Command="{Binding RegeneratePreviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    automation:AutomationProperties.Name="Regenerate operation preview" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedOperation.RetryGuidance}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <ProgressBar Value="{Binding SelectedOperation.ProgressPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,18,0,6" />
                        <TextBlock Text="{Binding SelectedOperation.CountsText}"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="Execution" Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,20,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="SERVER" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.ServerName}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="BOT PROFILE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.BotProfileIdText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="STARTED" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.StartedAtText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="DURATION" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.DurationText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="0,2,0,12">
                            <TextBlock Text="CORRELATION ID" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedOperation.CorrelationIdText}"
                                       Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="TARGET IDS" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedOperation.TargetIdsText}"
                                       Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="ESTIMATED REQUESTS / AUDIT REASON"
                                       Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Style="{StaticResource DetailValueStyle}">
                                <Run Text="{Binding SelectedOperation.RequestCountText, Mode=OneWay}" />
                                <Run Text="  •  " />
                                <Run Text="{Binding SelectedOperation.AuditReasonText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Expander Header="Safe technical result"
                                  Margin="0,12,0,12"
                                  IsExpanded="False"
                                  automation:AutomationProperties.Name="Safe technical operation result">
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="SAFE ERROR CODE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.ErrorCodeText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="EXCEPTION TYPE" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.ExceptionTypeText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="OUTCOME CERTAINTY" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.OutcomeCertaintyText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="BACKUP" Style="{StaticResource DetailLabelStyle}" />
                                <TextBlock Text="{Binding SelectedOperation.BackupText}"
                                           Style="{StaticResource DetailValueStyle}" />
                            </StackPanel>
                            </UniformGrid>
                        </Expander>
                        <StackPanel Margin="0,2,0,12">
                            <TextBlock Text="RECONCILIATION" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedOperation.ReconciliationText}"
                                       Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="COMPENSATION" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SelectedOperation.CompensationText}"
                                       Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>

                        <TextBlock Text="Step results" Style="{StaticResource SectionHeadingStyle}"
                                   Margin="0,12,0,10" />
                        <ItemsControl ItemsSource="{Binding SelectedOperation.StepResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelSurfaceStyle}"
                                            Padding="11"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="10">
                                                    <Run Text="Attempts: " />
                                                    <Run Text="{Binding AttemptCount, Mode=OneWay}" />
                                                    <Run Text="  •  Code: " />
                                                    <Run Text="{Binding Failure.SafeCode, Mode=OneWay,
                                                                        TargetNullValue=None}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Succeeded}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
