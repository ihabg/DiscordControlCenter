<Window x:Class="DiscordControlCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Discord Control Center"
        Width="1420"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource NavigationBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,16,22">
                    <Border Width="42"
                            Height="42"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="11"
                            HorizontalAlignment="Left">
                        <TextBlock Text="DC"
                                   Foreground="{StaticResource TextOnAccentBrush}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Control Center"
                               Style="{StaticResource SectionHeadingStyle}"
                               FontSize="18"
                               Margin="0,12,0,2" />
                    <TextBlock Text="Discord operations"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom"
                        Margin="16,16,16,22"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8">
                    <TextBlock Text="Official bot APIs only"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Navigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Margin="10,2"
                                    ToolTip="{Binding Label}"
                                    automation:AutomationProperties.Name="{Binding Label}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource ContentBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="105" />
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="188" />
                        <ColumnDefinition Width="184" />
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentTitle}"
                               Style="{StaticResource PageHeadingStyle}"
                               FontSize="22"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Margin="7,0">
                        <TextBlock Text="SEARCH" Style="{StaticResource ToolbarLabelStyle}" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search bots"
                                 ToolTip="Search bot name, username, or ID"
                                 automation:AutomationProperties.Name="Search bots" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="7,0">
                        <TextBlock Text="BOT" Style="{StaticResource ToolbarLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Bots}"
                                  SelectedItem="{Binding SelectedBot}"
                                  Tag="No bot selected"
                                  ToolTip="Select the bot used by toolbar context"
                                  automation:AutomationProperties.Name="Select bot">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding StateText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateToBrushConverter}}" />
                                            <TextBlock Text="{Binding StateText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="7,0">
                        <TextBlock Text="SERVER" Style="{StaticResource ToolbarLabelStyle}" />
                        <ComboBox IsEnabled="False"
                                  SelectedIndex="0"
                                  ToolTip="No servers are available until Server Explorer is implemented"
                                  automation:AutomationProperties.Name="Select server">
                            <ComboBoxItem Content="No servers available" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="7,0">
                        <TextBlock Text="CONNECTION" Style="{StaticResource ToolbarLabelStyle}" />
                        <Border Height="34"
                                Background="{StaticResource ElevatedSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,0"
                                ToolTip="Connection status for the selected bot"
                                automation:AutomationProperties.Name="Selected bot connection status">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9"
                                         Height="9"
                                         Margin="0,0,8,0"
                                         Fill="{Binding SelectedBot.State, Converter={StaticResource StateToBrushConverter}}" />
                                <TextBlock Text="{Binding SelectedBot.StateText, Mode=OneWay, TargetNullValue=No bot selected, FallbackValue=No bot selected}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="3,0,0,0">
                        <TextBlock Text="ALERTS"
                                   Style="{StaticResource ToolbarLabelStyle}"
                                   HorizontalAlignment="Center" />
                        <Button Content="●"
                                Height="34"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="No new notifications"
                                automation:AutomationProperties.Name="Notifications: no new notifications" />
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Background="{StaticResource ContentBackgroundBrush}" />
        </Grid>
    </Grid>
</Window>
