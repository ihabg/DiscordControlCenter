<Window x:Class="DiscordControlCenter.UiHarness.HarnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiscordControlCenter.App.Views;assembly=DiscordControlCenter.App"
        Title="Discord Control Center — UI Harness"
        Width="1600" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerSurfaceBrush}" Padding="12">
            <TextBlock Text="UI HARNESS — TEST DATA ONLY — DISCORD WRITES DISABLED"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackgroundBrush}" Padding="12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Scenario" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                <ComboBox Width="300" Margin="8,0,16,0" ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScenario}" />
                <Button Content="Normal layout" Command="{Binding NormalLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Narrow layout" Command="{Binding NarrowLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Toggle connection" Command="{Binding ToggleConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Toggle Send Messages" Command="{Binding ToggleSendMessagesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Reset test data" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <views:MessagesView DataContext="{Binding Approval}" />
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <views:ScheduledMessagesView Grid.Row="2" DataContext="{Binding ScheduledMessages}" />
        </Grid>
    </DockPanel>
</Window>
